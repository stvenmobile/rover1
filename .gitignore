# --- Arduino / ESP32 Build Artifacts ---
# Ignore the temporary build folders created by the IDE
**/build/
**/bin/
**/*.o
**/*.elf
**/*.bin
**/*.map

# --- Libraries ---
# Ignore third-party libraries (recommend installing via Library Manager instead)
firmware/libraries/

# --- Local Environment / OS ---
.DS_Store
Thumbs.db
*.local
# --- PlatformIO ---
**/.pio/
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json

# --- ROS 2 (colcon) ---
ros2/build/
ros2/install/
ros2/log/
__pycache__/
